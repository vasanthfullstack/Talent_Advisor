# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo
# Set to true to use mock responses locally without API calls
USE_MOCK_LLM=true

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_MOCK_EMBEDDINGS=false

# Vision Configuration (multimodal)
USE_MOCK_VISION=false
VISION_MODEL=gpt-4-vision-preview

# RAG Configuration
RAG_BACKEND=faiss
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5

# App Configuration
APP_NAME=AI Talent Advisor
APP_VERSION=1.0.0
DEBUG=true

# Paths
STUDENT_PROFILES_PATH=./student_profiles
DATA_PATH=./data
FAISS_INDEX_PATH=./data/faiss_index
METADATA_PATH=./data/metadata.json
